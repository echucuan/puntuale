# Copia este archivo a .env para desarrollo local: cp .env.example .env
# Todos los valores son FICTICIOS y solo sirven en desarrollo local.
# Nunca versiones un .env con valores reales.

NODE_ENV=development

# Puerto de la API
PORT=3000

# Puerto local de PostgreSQL (docker compose)
PUNTUALE_DB_PORT=5432
PUNTUALE_DB_ADMIN_PASSWORD=puntuale_admin_dev_only

# Conexión administrativa: crea roles y aplica migraciones. La API NUNCA la usa.
DATABASE_ADMIN_URL=postgres://puntuale_admin:puntuale_admin_dev_only@localhost:5432/puntuale

# Contraseña con que el bootstrap crea el rol de aplicación puntuale_app
APP_DB_PASSWORD=puntuale_app_dev_only

# Conexión de la API: rol puntuale_app (sin superusuario, sin BYPASSRLS, sin ser dueño de tablas)
DATABASE_URL=postgres://puntuale_app:puntuale_app_dev_only@localhost:5432/puntuale
