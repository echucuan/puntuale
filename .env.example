# Copia este archivo a .env para desarrollo local: cp .env.example .env
# Todos los valores son FICTICIOS y solo sirven en desarrollo local.
# Nunca versiones un .env con valores reales.

NODE_ENV=development

# Puerto de la API
PORT=3000

# Puerto local de PostgreSQL (docker compose)
PUNTUALE_DB_PORT=5432
PUNTUALE_DB_ADMIN_PASSWORD=puntuale_admin_dev_only

# Conexión administrativa: crea roles y aplica migraciones. La API NUNCA la usa.
DATABASE_ADMIN_URL=postgres://puntuale_admin:puntuale_admin_dev_only@localhost:5432/puntuale

# Contraseña con que el bootstrap crea el rol de aplicación puntuale_app
APP_DB_PASSWORD=puntuale_app_dev_only

# Conexión de la API: rol puntuale_app (sin superusuario, sin BYPASSRLS, sin ser dueño de tablas)
DATABASE_URL=postgres://puntuale_app:puntuale_app_dev_only@localhost:5432/puntuale

# Secreto para los HMAC de CSRF y de las llaves de límites de tasa (mínimo 32 caracteres).
# Producción rechaza este valor ficticio.
AUTH_SECRET=puntuale_auth_secret_dev_only_0123456789

# Llave maestra del cifrado de secretos TOTP (mínimo 32 caracteres, distinta de AUTH_SECRET).
# Si cambia, el MFA inscrito deja de funcionar. Producción rechaza este valor ficticio.
MFA_ENCRYPTION_KEY=puntuale_mfa_key_dev_only_0123456789abcd

# Orígenes permitidos por CORS, separados por comas. Fuera de producción solo se admite localhost.
CORS_ORIGINS=http://localhost:5173

# Valores opcionales (se muestran los valores por defecto):
# SESSION_ABSOLUTE_TTL_SECONDS=43200
# SESSION_IDLE_TTL_SECONDS=1800
# LOGIN_MAX_FAILURES_ACCOUNT=5
# LOGIN_MAX_FAILURES_IP=20
# LOGIN_FAILURE_WINDOW_SECONDS=900
# LOGIN_DELAY_BASE_MS=1000
# LOGIN_DELAY_MAX_MS=30000
# RATE_LIMIT_API_IP_PER_MINUTE=120
# RATE_LIMIT_API_SESSION_PER_MINUTE=300
# MFA_MAX_ATTEMPTS=5
# MFA_ATTEMPT_WINDOW_SECONDS=900
# MFA_ENROLLMENT_TTL_SECONDS=900
