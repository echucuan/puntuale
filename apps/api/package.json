{
  "name": "@puntuale/api",
  "version": "0.0.0",
  "private": true,
  "description": "API de Puntuale (NestJS): monolito modular.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.4.0",
    "@nestjs/core": "12.4.0",
    "@nestjs/platform-express": "12.4.0",
    "@node-rs/argon2": "2.2.2",
    "@puntuale/contracts": "workspace:*",
    "@puntuale/domain-rules": "workspace:*",
    "helmet": "8.3.0",
    "otpauth": "9.5.2",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.4.0",
    "@puntuale/db": "workspace:*",
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.2",
    "tsx": "4.23.15"
  }
}
